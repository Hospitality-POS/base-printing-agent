# PrintAgent environment configuration
# Copy this file to .env and fill in your values.
# Place .env in the same directory as the PrintAgent executable.

# Base URL of your cloud POS API (no trailing slash)
# Production:
#PRINT_AGENT_API_URL=https://api.hospitality.reliatech.co.ke
# Local dev (uncomment and comment out the line above):
PRINT_AGENT_API_URL=http://localhost:3002

# Optional: set log level (error | warn | info | debug | trace)
RUST_LOG=info
